::llvm::LogicalResult ConstructOp::verifyInvariantsImpl() {
  auto tblgen_isConstexpr = getProperties().isConstexpr; (void)tblgen_isConstexpr;
  auto tblgen_isStatic = getProperties().isStatic; (void)tblgen_isStatic;
  auto tblgen_types = getProperties().types; (void)tblgen_types;

  if (::mlir::failed(__mlir_ods_local_attr_constraint_Ops4(*this, tblgen_types, "types")))
    return ::mlir::failure();

  if (::mlir::failed(__mlir_ods_local_attr_constraint_Ops1(*this, tblgen_isConstexpr, "isConstexpr")))
    return ::mlir::failure();

  if (::mlir::failed(__mlir_ods_local_attr_constraint_Ops1(*this, tblgen_isStatic, "isStatic")))
    return ::mlir::failure();
  {
    unsigned index = 0; (void)index;
    auto valueGroup0 = getODSOperands(0);

    for (auto v : valueGroup0) {
      if (::mlir::failed(__mlir_ods_local_type_constraint_Ops7(*this, v.getType(), "operand", index++)))
        return ::mlir::failure();
    }
  }
  {
    unsigned index = 0; (void)index;
    auto valueGroup0 = getODSResults(0);

    for (auto v : valueGroup0) {
      if (::mlir::failed(__mlir_ods_local_type_constraint_Ops1(*this, v.getType(), "result", index++)))
        return ::mlir::failure();
    }
  }
  return ::mlir::success();
}

