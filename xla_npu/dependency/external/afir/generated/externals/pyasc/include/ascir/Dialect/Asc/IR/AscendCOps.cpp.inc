  return verifyInvariantsImpl();
}

::mlir::ParseResult ConstructOp::parse(::mlir::OpAsmParser &parser, ::mlir::OperationState &result) {
  ::mlir::Type resultRawType{};
  ::llvm::ArrayRef<::mlir::Type> resultTypes(&resultRawType, 1);
  ::llvm::SmallVector<::mlir::OpAsmParser::UnresolvedOperand, 4> operandsOperands;
  ::llvm::SMLoc operandsOperandsLoc;
  (void)operandsOperandsLoc;
  ::mlir::ArrayAttr typesAttr;
  ::llvm::SmallVector<::mlir::Type, 1> operandsTypes;

  {
    ::mlir::Type type;
    if (parser.parseCustomTypeWithFallback(type))
      return ::mlir::failure();
    resultRawType = type;
  }
  if (parser.parseLParen())
    return ::mlir::failure();

  operandsOperandsLoc = parser.getCurrentLocation();
  if (parser.parseOperandList(operandsOperands))
    return ::mlir::failure();
  if (!operandsOperands.empty()) {
  }
  if (parser.parseRParen())
    return ::mlir::failure();

  ::mlir::OptionalParseResult parseResulttypesAttr =
    parser.parseOptionalAttribute(typesAttr, parser.getBuilder().getType<::mlir::NoneType>());
  if (parseResulttypesAttr.has_value() && failed(*parseResulttypesAttr))
    return ::mlir::failure();
  if (parseResulttypesAttr.has_value() && succeeded(*parseResulttypesAttr))
  if (typesAttr) result.getOrAddProperties<ConstructOp::Properties>().types = typesAttr;
  if (typesAttr) {
  }
  if (::mlir::succeeded(parser.parseOptionalKeyword("constexpr"))) {
    result.getOrAddProperties<ConstructOp::Properties>().isConstexpr = parser.getBuilder().getUnitAttr();  }
  if (::mlir::succeeded(parser.parseOptionalKeyword("static"))) {
    result.getOrAddProperties<ConstructOp::Properties>().isStatic = parser.getBuilder().getUnitAttr();  }
  {
    auto loc = parser.getCurrentLocation();(void)loc;
    if (parser.parseOptionalAttrDict(result.attributes))
      return ::mlir::failure();
    if (failed(verifyInherentAttrs(result.name, result.attributes, [&]() {
        return parser.emitError(loc) << "'" << result.name.getStringRef() << "' op ";
      })))
      return ::mlir::failure();
  }
  if (::mlir::succeeded(parser.parseOptionalColon())) {

  if (parser.parseTypeList(operandsTypes))
    return ::mlir::failure();
  }
  result.addTypes(resultTypes);
  if (parser.resolveOperands(operandsOperands, operandsTypes, operandsOperandsLoc, result.operands))
    return ::mlir::failure();
  return ::mlir::success();
}

void ConstructOp::print(::mlir::OpAsmPrinter &_odsPrinter) {
  _odsPrinter << ' ';
  {
    auto type = getResult().getType();
    if (auto validType = ::llvm::dyn_cast<::mlir::Type>(type))
      _odsPrinter.printStrippedAttrOrType(validType);
   else
     _odsPrinter << type;
  }
  _odsPrinter << "(";
  if (!getOperands().empty()) {
    _odsPrinter << getOperands();
  }
  _odsPrinter << ")";
  if (getTypesAttr()) {
    _odsPrinter << ' ';
    _odsPrinter.printAttributeWithoutType(getTypesAttr());
  }
  if ((getIsConstexprAttr() && getIsConstexprAttr() != ((false) ? ::mlir::OpBuilder((*this)->getContext()).getUnitAttr() : nullptr))) {
    _odsPrinter << ' ' << "constexpr";
  }
  if ((getIsStaticAttr() && getIsStaticAttr() != ((false) ? ::mlir::OpBuilder((*this)->getContext()).getUnitAttr() : nullptr))) {
    _odsPrinter << ' ' << "static";
  }
  ::llvm::SmallVector<::llvm::StringRef, 2> elidedAttrs;
  elidedAttrs.push_back("types");
  elidedAttrs.push_back("isConstexpr");
  elidedAttrs.push_back("isStatic");
  {
     ::mlir::Builder odsBuilder(getContext());
     ::mlir::Attribute attr = getIsConstexprAttr();
     if(attr && (attr == ((false) ? odsBuilder.getUnitAttr() : nullptr)))
       elidedAttrs.push_back("isConstexpr");
  }
  {
     ::mlir::Builder odsBuilder(getContext());
     ::mlir::Attribute attr = getIsStaticAttr();
     if(attr && (attr == ((false) ? odsBuilder.getUnitAttr() : nullptr)))
       elidedAttrs.push_back("isStatic");
  }
  _odsPrinter.printOptionalAttrDict((*this)->getAttrs(), elidedAttrs);
  if (!getOperands().empty()) {
    _odsPrinter << ' ' << ":";
    _odsPrinter << ' ';
    _odsPrinter << getOperands().getTypes();
  }
}

