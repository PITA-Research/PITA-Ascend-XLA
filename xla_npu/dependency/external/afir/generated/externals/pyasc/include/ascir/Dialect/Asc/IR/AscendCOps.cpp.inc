}

::mlir::ParseResult MatmulIterateOp::parse(::mlir::OpAsmParser &parser, ::mlir::OperationState &result) {
  ::mlir::OpAsmParser::UnresolvedOperand matmulRawOperand{};
  ::llvm::ArrayRef<::mlir::OpAsmParser::UnresolvedOperand> matmulOperands(&matmulRawOperand, 1);  ::llvm::SMLoc matmulOperandsLoc;
  (void)matmulOperandsLoc;
  ::mlir::OpAsmParser::UnresolvedOperand partialsumRawOperand{};
  ::llvm::ArrayRef<::mlir::OpAsmParser::UnresolvedOperand> partialsumOperands(&partialsumRawOperand, 1);  ::llvm::SMLoc partialsumOperandsLoc;
  (void)partialsumOperandsLoc;
  ::mlir::OpAsmParser::UnresolvedOperand syncRawOperand{};
  ::llvm::ArrayRef<::mlir::OpAsmParser::UnresolvedOperand> syncOperands(&syncRawOperand, 1);  ::llvm::SMLoc syncOperandsLoc;
  (void)syncOperandsLoc;
  ::llvm::SmallVector<::mlir::OpAsmParser::UnresolvedOperand, 4> localCmaxtrixOperands;
  ::llvm::SMLoc localCmaxtrixOperandsLoc;
  (void)localCmaxtrixOperandsLoc;
  ::mlir::Type matmulRawType{};
  ::llvm::ArrayRef<::mlir::Type> matmulTypes(&matmulRawType, 1);
  ::mlir::Type partialsumRawType{};
  ::llvm::ArrayRef<::mlir::Type> partialsumTypes(&partialsumRawType, 1);
  ::mlir::Type syncRawType{};
  ::llvm::ArrayRef<::mlir::Type> syncTypes(&syncRawType, 1);
  ::llvm::SmallVector<::mlir::Type, 1> localCmaxtrixTypes;
  ::mlir::Type resultRawType{};
  ::llvm::ArrayRef<::mlir::Type> resultTypes(&resultRawType, 1);

  matmulOperandsLoc = parser.getCurrentLocation();
  if (parser.parseOperand(matmulRawOperand))
    return ::mlir::failure();
  if (parser.parseComma())
    return ::mlir::failure();

  partialsumOperandsLoc = parser.getCurrentLocation();
  if (parser.parseOperand(partialsumRawOperand))
    return ::mlir::failure();
  if (parser.parseComma())
    return ::mlir::failure();

  syncOperandsLoc = parser.getCurrentLocation();
  if (parser.parseOperand(syncRawOperand))
    return ::mlir::failure();
  {
    auto loc = parser.getCurrentLocation();(void)loc;
    if (parser.parseOptionalAttrDict(result.attributes))
      return ::mlir::failure();
    if (failed(verifyInherentAttrs(result.name, result.attributes, [&]() {
        return parser.emitError(loc) << "'" << result.name.getStringRef() << "' op ";
      })))
      return ::mlir::failure();
  }
  if (::mlir::succeeded(parser.parseOptionalComma())) {

  {
    localCmaxtrixOperandsLoc = parser.getCurrentLocation();
    ::mlir::OpAsmParser::UnresolvedOperand operand;
    ::mlir::OptionalParseResult parseResult =
                                    parser.parseOptionalOperand(operand);
    if (parseResult.has_value()) {
      if (failed(*parseResult))
        return ::mlir::failure();
      localCmaxtrixOperands.push_back(operand);
    }
  }
  }
  if (parser.parseColon())
    return ::mlir::failure();

  if (parser.parseType(matmulRawType))
    return ::mlir::failure();
  if (parser.parseComma())
    return ::mlir::failure();

  {
    ::mlir::Type type;
    if (parser.parseCustomTypeWithFallback(type))
      return ::mlir::failure();
    partialsumRawType = type;
  }
  if (parser.parseComma())
    return ::mlir::failure();

  {
    ::mlir::Type type;
    if (parser.parseCustomTypeWithFallback(type))
      return ::mlir::failure();
    syncRawType = type;
  }
  if (::mlir::succeeded(parser.parseOptionalComma())) {

  {
    ::mlir::Type optionalType;
    ::mlir::OptionalParseResult parseResult =
                                    parser.parseOptionalType(optionalType);
    if (parseResult.has_value()) {
      if (failed(*parseResult))
        return ::mlir::failure();
      localCmaxtrixTypes.push_back(optionalType);
    }
  }
  }
  if (parser.parseComma())
    return ::mlir::failure();

  {
    ::mlir::Type type;
    if (parser.parseCustomTypeWithFallback(type))
      return ::mlir::failure();
    resultRawType = type;
  }
  result.addTypes(resultTypes);
  if (parser.resolveOperands(matmulOperands, matmulTypes, matmulOperandsLoc, result.operands))
    return ::mlir::failure();
  if (parser.resolveOperands(partialsumOperands, partialsumTypes, partialsumOperandsLoc, result.operands))
    return ::mlir::failure();
  if (parser.resolveOperands(localCmaxtrixOperands, localCmaxtrixTypes, localCmaxtrixOperandsLoc, result.operands))
    return ::mlir::failure();
  if (parser.resolveOperands(syncOperands, syncTypes, syncOperandsLoc, result.operands))
    return ::mlir::failure();
  return ::mlir::success();
}

void MatmulIterateOp::print(::mlir::OpAsmPrinter &_odsPrinter) {
  _odsPrinter << ' ';
  _odsPrinter << getMatmul();
  _odsPrinter << ",";
  _odsPrinter << ' ';
  _odsPrinter << getPartialsum();
  _odsPrinter << ",";
  _odsPrinter << ' ';
  _odsPrinter << getSync();
  ::llvm::SmallVector<::llvm::StringRef, 2> elidedAttrs;
  _odsPrinter.printOptionalAttrDict((*this)->getAttrs(), elidedAttrs);
  if (getLocalCmaxtrix()) {
    _odsPrinter << ",";
    _odsPrinter << ' ';
    if (::mlir::Value value = getLocalCmaxtrix())
      _odsPrinter << value;
  }
  _odsPrinter << ' ' << ":";
  _odsPrinter << ' ';
   _odsPrinter << getMatmul().getType();
  _odsPrinter << ",";
  _odsPrinter << ' ';
  {
    auto type = getPartialsum().getType();
    if (auto validType = ::llvm::dyn_cast<::mlir::Type>(type))
      _odsPrinter.printStrippedAttrOrType(validType);
   else
     _odsPrinter << type;
  }
  _odsPrinter << ",";
  _odsPrinter << ' ';
  {
    auto type = getSync().getType();
    if (auto validType = ::llvm::dyn_cast<::mlir::Type>(type))
      _odsPrinter.printStrippedAttrOrType(validType);
   else
     _odsPrinter << type;
  }
  if (getLocalCmaxtrix()) {
    _odsPrinter << ",";
    _odsPrinter << ' ';
    _odsPrinter << (getLocalCmaxtrix() ? ::llvm::ArrayRef<::mlir::Type>(getLocalCmaxtrix().getType()) : ::llvm::ArrayRef<::mlir::Type>());
  }
  _odsPrinter << ",";
  _odsPrinter << ' ';
  {
    auto type = getResult().getType();
    if (auto validType = ::llvm::dyn_cast<::mlir::Type>(type))
      _odsPrinter.printStrippedAttrOrType(validType);
   else
     _odsPrinter << type;
  }
}


