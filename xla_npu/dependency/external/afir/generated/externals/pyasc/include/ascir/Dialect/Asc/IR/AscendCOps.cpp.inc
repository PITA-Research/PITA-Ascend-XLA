::mlir::ParseResult ScalarCastOp::parse(::mlir::OpAsmParser &parser, ::mlir::OperationState &result) {
  ::mlir::OpAsmParser::UnresolvedOperand valueInRawOperand{};
  ::llvm::ArrayRef<::mlir::OpAsmParser::UnresolvedOperand> valueInOperands(&valueInRawOperand, 1);  ::llvm::SMLoc valueInOperandsLoc;
  (void)valueInOperandsLoc;
  ::mlir::Type valueInRawType{};
  ::llvm::ArrayRef<::mlir::Type> valueInTypes(&valueInRawType, 1);
  ::mlir::Type valueOutRawType{};
  ::llvm::ArrayRef<::mlir::Type> valueOutTypes(&valueOutRawType, 1);

  valueInOperandsLoc = parser.getCurrentLocation();
  if (parser.parseOperand(valueInRawOperand))
    return ::mlir::failure();
  {
    auto loc = parser.getCurrentLocation();(void)loc;
    if (parser.parseOptionalAttrDict(result.attributes))
      return ::mlir::failure();
    if (failed(verifyInherentAttrs(result.name, result.attributes, [&]() {
        return parser.emitError(loc) << "'" << result.name.getStringRef() << "' op ";
      })))
      return ::mlir::failure();
  }
  if (parser.parseColon())
    return ::mlir::failure();

  {
    ::mlir::Type type;
    if (parser.parseCustomTypeWithFallback(type))
      return ::mlir::failure();
    valueInRawType = type;
  }
  if (parser.parseArrow())
    return ::mlir::failure();

  {
    ::mlir::Type type;
    if (parser.parseCustomTypeWithFallback(type))
      return ::mlir::failure();
    valueOutRawType = type;
  }
  result.addTypes(valueOutTypes);
  if (parser.resolveOperands(valueInOperands, valueInTypes, valueInOperandsLoc, result.operands))
    return ::mlir::failure();
  return ::mlir::success();
}

