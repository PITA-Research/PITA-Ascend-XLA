::llvm::LogicalResult AllOpAdaptor::verify(::mlir::Location loc) {
  auto namedAttrRange = odsAttrs;
  auto namedAttrIt = namedAttrRange.begin();
  ::mlir::Attribute tblgen_axis;

  while (true) {
    if (namedAttrIt == namedAttrRange.end())
      return emitError(loc, "'afir.all' op requires attribute 'axis'");
    if (namedAttrIt->getName() == AllOp::getAxisAttrName(*odsOpName)) {
      tblgen_axis = namedAttrIt->getValue();
      break;
    }
    ++namedAttrIt;
  }
  ::mlir::Attribute tblgen_indexing_maps;
  ::mlir::Attribute tblgen_ir_attr_def;
  ::mlir::Attribute tblgen_loop_axis;
  ::mlir::Attribute tblgen_outputs;
  ::mlir::Attribute tblgen_tmp_buffers;
  while (true) {
    if (namedAttrIt == namedAttrRange.end()) {
      break;
    }
    else if (namedAttrIt->getName() == AllOp::getIndexingMapsAttrName(*odsOpName)) {
      tblgen_indexing_maps = namedAttrIt->getValue();
    }
    else if (namedAttrIt->getName() == AllOp::getIrAttrDefAttrName(*odsOpName)) {
      tblgen_ir_attr_def = namedAttrIt->getValue();
    }
    else if (namedAttrIt->getName() == AllOp::getLoopAxisAttrName(*odsOpName)) {
      tblgen_loop_axis = namedAttrIt->getValue();
    }
    else if (namedAttrIt->getName() == AllOp::getOutputsAttrName(*odsOpName)) {
      tblgen_outputs = namedAttrIt->getValue();
    }
    else if (namedAttrIt->getName() == AllOp::getTmpBuffersAttrName(*odsOpName)) {
      tblgen_tmp_buffers = namedAttrIt->getValue();
    }
    ++namedAttrIt;
  }

  if (tblgen_axis && !(((::llvm::isa<::mlir::IntegerAttr>(tblgen_axis))) && ((::llvm::cast<::mlir::IntegerAttr>(tblgen_axis).getType().isSignlessInteger(32)))))
    return emitError(loc, "'afir.all' op attribute 'axis' failed to satisfy constraint: 32-bit signless integer attribute");

  if (tblgen_indexing_maps && !(((::llvm::isa<::mlir::ArrayAttr>(tblgen_indexing_maps))) && (::llvm::all_of(::llvm::cast<::mlir::ArrayAttr>(tblgen_indexing_maps), [&](::mlir::Attribute attr) { return attr && ((::llvm::isa<::mlir::AffineMapAttr>(attr))); }))))
    return emitError(loc, "'afir.all' op attribute 'indexing_maps' failed to satisfy constraint: AffineMap array attribute");

  if (tblgen_loop_axis && !(((::llvm::isa<::mlir::IntegerAttr>(tblgen_loop_axis))) && ((::llvm::cast<::mlir::IntegerAttr>(tblgen_loop_axis).getType().isSignlessInteger(32)))))
    return emitError(loc, "'afir.all' op attribute 'loop_axis' failed to satisfy constraint: 32-bit signless integer attribute");

  if (tblgen_ir_attr_def && !((::llvm::isa<::mlir::DictionaryAttr>(tblgen_ir_attr_def))))
    return emitError(loc, "'afir.all' op attribute 'ir_attr_def' failed to satisfy constraint: dictionary of named attribute values");

  if (tblgen_tmp_buffers && !(((::llvm::isa<::mlir::ArrayAttr>(tblgen_tmp_buffers))) && (::llvm::all_of(::llvm::cast<::mlir::ArrayAttr>(tblgen_tmp_buffers), [&](::mlir::Attribute attr) { return attr && ((::llvm::isa<::mlir::afir::TmpBufDescAttr>(attr))); }))))
    return emitError(loc, "'afir.all' op attribute 'tmp_buffers' failed to satisfy constraint: Array of TmpBufDesc attributes");

  if (tblgen_outputs && !(((::llvm::isa<::mlir::ArrayAttr>(tblgen_outputs))) && (::llvm::all_of(::llvm::cast<::mlir::ArrayAttr>(tblgen_outputs), [&](::mlir::Attribute attr) { return attr && ((::llvm::isa<::mlir::afir::AscTensorGroupsAttr>(attr))); }))))
    return emitError(loc, "'afir.all' op attribute 'outputs' failed to satisfy constraint: Array of AscTensorGroups attributes");
  return ::mlir::success();
}

