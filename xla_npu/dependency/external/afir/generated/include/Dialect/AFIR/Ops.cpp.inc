    ::llvm::LogicalResult
    MaximumOp::inferReturnTypeComponents(::mlir::MLIRContext *context,
                      std::optional<::mlir::Location> location,
                      ::mlir::ValueShapeRange operands, ::mlir::DictionaryAttr attributes,
                      ::mlir::OpaqueProperties properties, ::mlir::RegionRange regions,
                      ::llvm::SmallVectorImpl<::mlir::ShapedTypeComponents> &inferredReturnShapes) {
      MaximumOp::Adaptor adaptor(operands, attributes, properties, regions);
      return MaximumOp::inferReturnTypeComponents(context,
        location, adaptor, inferredReturnShapes);
    }


    LogicalResult
    MaximumOp::inferReturnTypes(::mlir::MLIRContext *context,
                      std::optional<::mlir::Location> location,
                      ::mlir::ValueRange operands, ::mlir::DictionaryAttr attributes,
                      ::mlir::OpaqueProperties properties, ::mlir::RegionRange regions,
                      ::llvm::SmallVectorImpl<::mlir::Type> &inferredReturnTypes) {
      SmallVector<ShapedTypeComponents, 2> retComponents;
      if (failed(MaximumOp::inferReturnTypeComponents(context, location,
                                operands, attributes, properties, regions,
                                retComponents)))
        return failure();
      return ::mlir::detail::inferReturnTensorTypes(retComponents,
                                inferredReturnTypes);
    }


bool MaximumOp::isCompatibleReturnTypes(TypeRange l, TypeRange r) {
  if (l.size() != r.size() || l.size() != 1) return false;
  return succeeded(verifyCompatibleShape(l[0], r[0]));
}

